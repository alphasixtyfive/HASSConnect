<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="HASS Connect" Manufacturer="alphasixtyfive" Version="$(var.AppVersion)" Language="1033"
           UpgradeCode="4425a4df-c2aa-45cf-bce4-f50a0945dddb" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of HASS Connect is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000)" Message="HASS Connect requires Windows 11 x64." />
    <Icon Id="AppIcon" SourceFile="$(var.AppSource)\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/alphasixtyfive/HASSConnect" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="HASSConnect" /></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuLink" Name="HASS Connect" Target="[INSTALLFOLDER]HassConnect.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\HASSConnect\Installer" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
      </Component>
    </StandardDirectory>
    <CustomAction Id="StopApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]HassConnect.App.exe&quot; --shutdown" Execute="immediate" Return="check" />
    <CustomAction Id="UnregisterApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]HassConnect.App.exe&quot; --unregister-notifications" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopApp" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="UnregisterApp" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Feature Id="App" Title="HASS Connect" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" /><ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
