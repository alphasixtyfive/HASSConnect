<Window x:Class="HassConnect.App.CameraPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Camera">
    <Grid x:Name="Surface" Background="{ThemeResource WindowSurfaceBrush}" Padding="12,8,12,12">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Close_Invoked" />
        </Grid.KeyboardAccelerators>
        <Border Background="#101113" BorderBrush="{ThemeResource SectionBorderBrush}"
                BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid x:Name="Viewport" SizeChanged="Viewport_SizeChanged">
                <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" />
                <Image x:Name="Snapshot" Visibility="Collapsed" AutomationProperties.Name="Camera snapshot" />
                <FontIcon x:Name="EmptyPreview" Glyph="&#xE722;" FontSize="32" Foreground="#A2A4AB"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="11,7"
                        Background="#E6202124" CornerRadius="{ThemeResource OverlayCornerRadius}" RequestedTheme="Dark">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ProgressRing x:Name="Loading" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                        <Ellipse x:Name="LiveIndicator" Width="8" Height="8" VerticalAlignment="Center" Visibility="Collapsed"
                                 Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="StreamStatus" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border x:Name="SnapshotBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="12" Padding="9,6" Background="#E6202124" CornerRadius="{ThemeResource OverlayCornerRadius}" Visibility="Collapsed">
                    <TextBlock Text="Snapshot" Foreground="#FFFFFF" FontSize="12" />
                </Border>

                <Grid VerticalAlignment="Bottom" Margin="12" ColumnSpacing="10" RequestedTheme="Dark">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CameraActionOverlay" Background="#E6202124" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4"
                            Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <StackPanel x:Name="CameraActionControls" />
                    </Border>
                    <Border Grid.Column="1" Background="#E6202124" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="RetryButton" Content="Retry" MinHeight="34" Visibility="Collapsed" Click="Retry_Click" />
                            <ToggleButton x:Name="SoundButton" Width="38" Height="36" Padding="0" Click="Sound_Click"
                                          AutomationProperties.Name="Camera sound">
                                <FontIcon x:Name="SoundIcon" Glyph="&#xE767;" FontSize="16" />
                            </ToggleButton>
                            <ToggleButton x:Name="MicrophoneButton" Width="38" Height="36" Padding="0" IsEnabled="False"
                                          Click="Microphone_Click" AutomationProperties.Name="Microphone">
                                <FontIcon x:Name="MicrophoneIcon" Glyph="&#xEC54;" FontSize="16" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </Grid>
                <InfoBar x:Name="CameraActionFeedback" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                         Margin="12,0,12,64" IsOpen="False" RequestedTheme="Dark" />
            </Grid>
        </Border>
    </Grid>
</Window>
