<Window x:Class="HassConnect.App.QuickAccessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quick access">
  <Border x:Name="Surface" Background="{ThemeResource CardSurfaceBrush}"
          KeyDown="Surface_KeyDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="16,14,16,14">
        <TextBlock Text="Quick access" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>

      <TextBlock x:Name="ConnectionMessage" Grid.Row="1" Visibility="Collapsed"
                 Text="Home Assistant is disconnected. Actions are unavailable."
                 FontSize="12" TextWrapping="Wrap" Margin="16,0,16,8"
                 AutomationProperties.LiveSetting="Polite"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <ScrollViewer x:Name="ActionsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" Margin="16,0,16,8">
        <Grid>
          <Grid x:Name="ActionsGrid" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          </Grid>
          <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
            <FontIcon Glyph="&#xE710;" FontSize="28" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyMessage" Text="No quick actions yet."
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="EmptyActionButton" Content="Add an action"
                             HorizontalAlignment="Center" Click="Edit_Click" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="3" Background="{ThemeResource WindowSurfaceBrush}"
              BorderBrush="{ThemeResource SectionBorderBrush}" BorderThickness="0,1,0,0"
              Padding="8,2">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <Button Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                  Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="True"
                  Click="OpenHomeAssistant_Click" ToolTipService.ToolTip="Open Home Assistant"
                  AutomationProperties.Name="Open Home Assistant">
            <FontIcon Glyph="&#xE80F;" FontSize="16" Width="16" Height="16" />
          </Button>
          <Button x:Name="SettingsButton" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                  Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="True"
                  Click="Edit_Click" ToolTipService.ToolTip="Quick access settings"
                  AutomationProperties.Name="Quick access settings">
            <FontIcon Glyph="&#xE713;" FontSize="16" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
