<UserControl x:Class="HassConnect.App.Views.QuickActionIconPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="4">
  <TextBlock Text="Icon" />
  <Button x:Name="PickerButton" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          UseSystemFocusVisuals="True" AutomationProperties.Name="Choose quick action icon">
    <Button.Content>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="SelectedGlyph" FontSize="16" Width="20" />
        <TextBlock x:Name="SelectedLabel" Grid.Column="1" Text="Automatic"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" />
      </Grid>
    </Button.Content>
    <Button.Flyout>
      <Flyout x:Name="IconFlyout" Opened="IconFlyout_Opened" Placement="BottomEdgeAlignedLeft">
        <StackPanel Width="380" Spacing="8">
          <TextBlock Text="Choose icon" FontSize="16" FontWeight="SemiBold" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
            <TextBox x:Name="IconSearch" PlaceholderText="Search icons" TextChanged="IconFilter_Changed"
                     AutomationProperties.Name="Search icons" />
            <ComboBox x:Name="IconCategory" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectionChanged="IconCategory_Changed" AutomationProperties.Name="Icon category">
              <ComboBoxItem Content="All" Tag="" />
              <ComboBoxItem Content="Home" Tag="Home" />
              <ComboBoxItem Content="Devices" Tag="Devices" />
              <ComboBoxItem Content="Media" Tag="Media" />
              <ComboBoxItem Content="Symbols" Tag="Symbols" />
            </ComboBox>
          </Grid>
          <Button x:Name="AutomaticButton" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Click="Automatic_Click"
                  AutomationProperties.Name="Automatic icon">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="AutomaticGlyph" FontSize="20" Width="24" />
                <StackPanel Spacing="1">
                  <TextBlock Text="Automatic" />
                  <TextBlock Text="Use the current entity icon" FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <FontIcon x:Name="AutomaticCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="16"
                        Visibility="Collapsed" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
          </Button>
          <GridView x:Name="IconGrid" Height="292" HorizontalAlignment="Stretch"
                    SelectionMode="Single" IsItemClickEnabled="True" ItemClick="IconGrid_ItemClick"
                    AutomationProperties.Name="Available icons">
            <GridView.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="62" Height="62" Spacing="3" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{Binding Name}">
                  <FontIcon Glyph="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
              </DataTemplate>
            </GridView.ItemTemplate>
          </GridView>
          <TextBlock x:Name="NoIconsMessage" Text="No matching icons." Visibility="Collapsed"
                     AutomationProperties.LiveSetting="Polite"
                     HorizontalAlignment="Center" FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
  </StackPanel>
</UserControl>
