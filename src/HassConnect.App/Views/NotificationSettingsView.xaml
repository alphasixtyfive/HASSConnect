<UserControl x:Class="HassConnect.App.Views.NotificationSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HassConnect.App.Views">
    <StackPanel Spacing="12">
        <Border Background="{ThemeResource CardSurfaceBrush}"
                BorderBrush="{ThemeResource SectionBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <views:SettingsRow x:Name="MasterRow" Title="Enable notifications" Glyph="&#xE8F2;"
                               ToolTipService.ToolTip="Requires this PC and HASS Connect to be running. Messages are not queued while offline."
                               IsToggleEnabled="False" ShowDivider="False" ToggleChanged="Master_Changed" />
        </Border>
        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border Background="{ThemeResource CardSurfaceBrush}"
                BorderBrush="{ThemeResource SectionBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <views:SettingsRow x:Name="SoundRow" Title="Sound" Glyph="&#xE767;" IsToggleEnabled="False"
                                   ToggleChanged="Sound_Changed" />
                <views:SettingsRow x:Name="TestRow" Title="Test notification" Glyph="&#xE945;" ShowDivider="False">
                    <views:SettingsRow.TrailingContent>
                        <Button x:Name="TestButton" Content="Send test" IsEnabled="False" Click="Test_Click"
                                AutomationProperties.Name="Send test notification" />
                    </views:SettingsRow.TrailingContent>
                </views:SettingsRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
