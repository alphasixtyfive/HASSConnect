<Application x:Class="HassConnect.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="WindowSurfaceColor">#F3F3F3</Color>
          <Color x:Key="NavigationSurfaceColor">#EBEBEB</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="#DEDEDE" />
          <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#FDE7E9" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPointerOverBrush" Color="#FBD0D4" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPressedBrush" Color="#F7B7BD" />
          <SolidColorBrush x:Key="DangerButtonBackgroundDisabledBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#E37D85" />
          <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#A4262C" />
          <SolidColorBrush x:Key="DangerButtonForegroundPointerOverBrush" Color="#A4262C" />
          <SolidColorBrush x:Key="DangerButtonForegroundPressedBrush" Color="#A4262C" />
          <SolidColorBrush x:Key="DangerButtonForegroundDisabledBrush" Color="#5C000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="WindowSurfaceColor">#202020</Color>
          <Color x:Key="NavigationSurfaceColor">#1B1B1B</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#202020" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="#404040" />
          <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#512329" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPointerOverBrush" Color="#6A2B33" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPressedBrush" Color="#3E191E" />
          <SolidColorBrush x:Key="DangerButtonBackgroundDisabledBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#8B414A" />
          <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFD9DC" />
          <SolidColorBrush x:Key="DangerButtonForegroundPointerOverBrush" Color="#FFD9DC" />
          <SolidColorBrush x:Key="DangerButtonForegroundPressedBrush" Color="#FFD9DC" />
          <SolidColorBrush x:Key="DangerButtonForegroundDisabledBrush" Color="#5DFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <Color x:Key="WindowSurfaceColor">#000000</Color>
          <Color x:Key="NavigationSurfaceColor">#000000</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="DangerButtonBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="DangerButtonBackgroundDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
          <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
          <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
          <SolidColorBrush x:Key="DangerButtonForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
          <SolidColorBrush x:Key="DangerButtonForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
          <SolidColorBrush x:Key="DangerButtonForegroundDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SectionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="SupportingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SettingsSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
      <ControlTemplate x:Key="SettingsGroupCard" TargetType="ContentControl">
        <Border Background="{ThemeResource CardSurfaceBrush}"
                BorderBrush="{ThemeResource SectionBorderBrush}"
                BorderThickness="1" CornerRadius="8">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
