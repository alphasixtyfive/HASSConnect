<Application x:Class="HassConnect.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="WindowSurfaceColor">#F3F3F3</Color>
          <Color x:Key="NavigationSurfaceColor">#EBEBEB</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="#DEDEDE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="WindowSurfaceColor">#202020</Color>
          <Color x:Key="NavigationSurfaceColor">#1B1B1B</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#202020" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="#404040" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <Color x:Key="WindowSurfaceColor">#000000</Color>
          <Color x:Key="NavigationSurfaceColor">#000000</Color>
          <SolidColorBrush x:Key="WindowSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="SectionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SectionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="SupportingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <ControlTemplate x:Key="SettingsGroupCard" TargetType="ContentControl">
        <Border Background="{ThemeResource CardSurfaceBrush}"
                BorderBrush="{ThemeResource SectionBorderBrush}"
                BorderThickness="1" CornerRadius="8">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
